{
  "slug": "build-it-iq",
  "title": "Build It × IQ",
  "client": "Build It / Blyvoor",
  "summary": "How a multi-store marketplace connects to per-store IQ Retail APIs — from onboard and catalogue unify through Ozow pending to sales-order write and capture.",
  "updatedAt": "2026-11-19T15:00:00.000Z",
  "sections": {
    "problem": {
      "headline": "The problem",
      "lede": "One marketplace cart. Many independent IQ worlds. Stock truth, product codes, and sales still live in each store.",
      "blocks": [
        {
          "label": "Tension",
          "title": "One cart, many IQs",
          "body": "Shoppers need one catalogue, one checkout (Ozow), and fulfilment from the best local store. Truth for stock, price, and sales still lives in each store’s IQ Retail / IQ Enterprise system.",
          "bullets": [
            "Each store is a standalone IQ server + database. No shared product codes across stores (cement can be 0101 in one store and CEM in another).",
            "Store owners control their own data. There is no single group catalogue to lean on.",
            "On-hand quantities are unreliable (stock can go negative when goods arrive on delivery note before invoice).",
            "Paid web orders must land in IQ without re-keying, with payment and web references visible to staff."
          ]
        },
        {
          "label": "What we cannot afford",
          "title": "Failure modes",
          "tone": "dark",
          "bullets": [
            "Oversell from bad live quantities on the site.",
            "Orders stuck outside IQ.",
            "Till or network load from chatty sync.",
            "Two stores, two SKU languages, one confused shopper."
          ]
        },
        {
          "label": "Today’s reality",
          "title": "How IQ is set up",
          "bullets": [
            "One integration endpoint per store.",
            "IQ exposes a REST API (JSON or XML) via IQEntAPIRestServer on the store server.",
            "API config is per store: port, SSL/TLS certificates, authentication, rate limits.",
            "Versions can differ between stores. API behaviour depends on version alignment."
          ]
        },
        {
          "label": "Catalogue reality",
          "title": "Same product, different codes",
          "bullets": [
            "No enforced SKU scheme across stores.",
            "Departments are more standardised than codes.",
            "Weights, dimensions, and images are often empty.",
            "FTG already maintains a large supplier master map that can seed unification."
          ]
        }
      ]
    },
    "solving": {
      "headline": "What we are solving",
      "lede": "The marketplace needs reliable reads from each store, safe writes back into IQ, and one product language for shoppers.",
      "blocks": [
        {
          "label": "Must read",
          "title": "Per-store truth",
          "bullets": [
            "Products / stock master (codes, departments, barcodes).",
            "Stock signal for allocation (honest scarcity, not fragile live on-hand).",
            "Selling prices and active promotions."
          ]
        },
        {
          "label": "Must write",
          "title": "No re-key path",
          "bullets": [
            "Sales order for paid web orders in the winning store’s IQ.",
            "Customer create / match without duplicates.",
            "Web order id + Ozow payment reference visible to staff.",
            "Delivery fee line as stores already capture at POS."
          ]
        },
        {
          "label": "Also required",
          "title": "Unify products across stores",
          "tone": "preferred",
          "body": "Shoppers see one cement bag. Behind the scenes, Platform45 maps each store’s local SKU into a canonical product, using supplier master data and a confidence-scored matching engine."
        }
      ]
    },
    "solution": {
      "headline": "Our solution",
      "lede": "Per-store IQ REST API, Platform45 background jobs, and a matching engine in the middle. No store-side SQL agent.",
      "blocks": [
        {
          "label": "Approach",
          "title": "API first",
          "tone": "dark",
          "body": "Each store runs IQEntAPIRestServer. Platform45 stores that store’s config (host, port, TLS certificates, Basic auth, rate limits). Background jobs fetch catalogue and stock, and confirm pending orders by calling the store API. A matching engine unifies divergent SKUs into one ecommerce catalogue."
        },
        {
          "label": "1 · Connect",
          "title": "Per-store API config",
          "tone": "preferred",
          "bullets": [
            "Listen port and IP",
            "TLS certificate, key, password",
            "Basic authentication",
            "Token expiry and rate limit"
          ]
        },
        {
          "label": "2 · Unify",
          "title": "Matching engine",
          "tone": "preferred",
          "bullets": [
            "Seed from FTG master mapping",
            "Score by confidence",
            "Auto-approve high confidence",
            "Human review below the threshold",
            "Rules learn from confirmed matches"
          ]
        },
        {
          "label": "3 · Trade safely",
          "title": "Jobs + pending pay",
          "tone": "preferred",
          "bullets": [
            "Sync catalogue and stock in the background",
            "No live on-hand on the front end",
            "Checkout creates a pending order after Ozow",
            "Job confirms with the store API, then captures"
          ]
        },
        {
          "label": "Stock honesty",
          "title": "Cache, don’t live-stream",
          "body": "On-hand can go negative in IQ. We prefer a cached stock signal on the storefront and a final stock check against the API only at purchase time."
        },
        {
          "label": "If the API path struggles",
          "title": "File fallback",
          "body": "Scheduled stock and price exports, plus importable order files, keep a pilot alive while the REST path is hardened. Same catalogue mapping either way."
        }
      ]
    }
  },
